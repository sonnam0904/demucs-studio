build/bin
node_modules

# Local CodeGraph index — 7 MB of derived SQLite, rebuilt by `codegraph sync`.
.codegraph/

# MkDocs output; the site is built and published by .github/workflows/docs.yml.
site/

# Written by semantic-release's verifyReleaseCmd so the workflow can read the
# next version without scraping the log.
.next-version
frontend/dist/*
!frontend/dist/gitkeep

# Leading slash matters: an unanchored `dist/` also matches frontend/dist/, and
# git cannot re-include a file whose parent directory is excluded — which
# silently killed the gitkeep exception two lines up.
/dist/
*.tar.gz
*.deb
*.rpm
*.zip
*.dmg
